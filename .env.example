# === WA AI BOT B ===
# Prefix perintah (default titik)
PREFIX=.

# Nomor WA untuk pairing code (format: 6281234567890, tanpa + / spasi)
# Kosongkan untuk pakai QR di terminal
PAIRING_NUMBER=

# Nomor owner bot (format: 6281234567890, tanpa + / spasi) — hanya nomor ini yg bisa pakai .run
OWNER_NUMBER=

# Gemini — https://aistudio.google.com → Get API Key
GEMINI_API_KEY=

# Groq — https://console.groq.com → API Keys → Create
GROQ_API_KEY=

# API publik gratis tanpa key untuk .aio/.spotify/.gdrive/.deepsearch
# Base URL dapat diganti jika domain mirror berubah.
PUBLIC_API_BASE=https://api.nexray.eu.cc

# === STORAGE (Fase 4 OPSIONAL, default NONAKTIF) ===
# json   -> perilaku seperti sekarang (lib/systems.js + database/*.json)
# sqlite -> pakai adapter baru src/storage/sqlite.js (data/bot.db, perlu npm i better-sqlite3)
DB_BACKEND=json
# Path DB SQLite opsional (default: data/bot.db)
# SQLITE_FILE=data/bot.db
